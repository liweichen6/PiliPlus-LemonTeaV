+// TEMPORARY, never committed: counters for the M16.3 device pass.
+abstract final class _TempProbe {
+  static const MethodChannel _ch = MethodChannel(TvVideoPlane.viewType);
+  static Timer? _timer;
+
+  static Future<void> start(NativePlayer player) async {
+    final text = await _ch.invokeMethod<String>('spikeConfig') ?? '';
+    final conf = <String, String>{
+      for (final line in text.split('\n'))
+        if (line.contains('='))
+          line.substring(0, line.indexOf('=')).trim(): line
+              .substring(line.indexOf('=') + 1)
+              .trim(),
+    };
+    // ignore: avoid_print
+    print(
+      '[m16] conf $conf qa=${GStorage.setting.get(SettingBoxKey.defaultVideoQa)}',
+    );
+    if (conf['codecs'] case final codecs?) {
+      GStorage.setting.put(SettingBoxKey.preferCodecs, codecs.split(','));
+    }
+    conf.forEach((k, v) {
+      if (k.startsWith('mpv.')) player.setProperty(k.substring(4), v);
+    });
+    if (conf['timings'] == '1') _FrameLog.start();
+    _timer?.cancel();
+    _timer = Timer.periodic(const Duration(seconds: 10), (_) {
+      String p(String name) {
+        try {
+          return player.getProperty(name);
+        } catch (_) {
+          return '?';
+        }
+      }
+
+      // ignore: avoid_print
+      print(
+        '[m16] stats pos=${p('time-pos')} vo=${p('vo')} '
+        'voconf=${p('vo-configured')} hwdec=${p('hwdec-current')} '
+        'codec=${p('video-codec')} size=${p('width')}x${p('height')} '
+        'fps=${p('estimated-vf-fps')} sync=${p('video-sync')} '
+        'drop=${p('frame-drop-count')} '
+        'decdrop=${p('decoder-frame-drop-count')} '
+        'delayed=${p('vo-delayed-frame-count')}',
+      );
+    });
+    player.release.add(() async => _timer?.cancel());
+  }
+}
+
+abstract final class _FrameLog {
+  static bool _started = false;
+  static final List<int> _build = [];
+  static final List<int> _raster = [];
+  static final List<int> _total = [];
+
+  static void start() {
+    if (_started) return;
+    _started = true;
+    WidgetsBinding.instance.addTimingsCallback((timings) {
+      for (final t in timings) {
+        _build.add(t.buildDuration.inMicroseconds);
+        _raster.add(t.rasterDuration.inMicroseconds);
+        _total.add(t.totalSpan.inMicroseconds);
+      }
+    });
+    Timer.periodic(const Duration(seconds: 10), (_) => _flush());
+  }
+
+  static String _stats(List<int> values) {
+    final sorted = values.toList()..sort();
+    int at(double p) => sorted[((sorted.length - 1) * p).round()];
+    return 'p50=${at(.5)} p90=${at(.9)} p99=${at(.99)} max=${sorted.last}';
+  }
+
+  static void _flush() {
+    if (_total.isNotEmpty) {
+      final over = _total.where((t) => t > 16667).length;
+      // ignore: avoid_print
+      print(
+        '[m16] frames=${_total.length} over16ms=$over '
+        'build ${_stats(_build)} raster ${_stats(_raster)} '
+        'total ${_stats(_total)}',
+      );
+    }
+    _build.clear();
+    _raster.clear();
+    _total.clear();
+  }
+}
