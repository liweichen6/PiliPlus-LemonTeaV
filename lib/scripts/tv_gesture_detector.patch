+          if (!isSelectKey) {
+            return KeyEventResult.ignored;
+          }
+          if (event is KeyDownEvent && onTap != null) {
+            onTap!();
+            return KeyEventResult.handled;
+          }
+          if (event is KeyRepeatEvent && onLongPress != null) {
+            onLongPress!();
+            return KeyEventResult.handled;
+          }
+          return KeyEventResult.ignored;
+        },
