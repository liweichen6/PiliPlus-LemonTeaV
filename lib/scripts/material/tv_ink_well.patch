+  KeyEventResult _handleDirectionalKeyEvent(FocusNode node, KeyEvent event) {
+    if (!node.hasPrimaryFocus ||
+        MediaQuery.maybeNavigationModeOf(context) != NavigationMode.directional) {
+      return KeyEventResult.ignored;
+    }
+    if (widget.onTap == null && widget.onTapDown != null && widget.onTapUp != null) {
